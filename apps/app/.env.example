# Despensa API (apps/api) — no trailing slash
API_URL=http://localhost:3333

# Clerk — https://dashboard.clerk.com
# Use the *same* Clerk instance the API validates tokens against, otherwise
# `requireAuth` rejects every request with "Invalid token".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
