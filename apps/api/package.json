{
  "name": "@despensa/api",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/shared/app.ts --outdir=dist --target=bun",
    "dev": "bun --watch src/shared/app.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "types": "tsc --noEmit",
    "db:generate": "bun drizzle-kit generate --name",
    "db:migrate": "bun drizzle-kit migrate",
    "db:studio": "bun drizzle-kit studio",
    "test": "bun test",
    "trigger:dev": "bunx trigger.dev@latest dev",
    "trigger:deploy": "bunx trigger.dev@latest deploy"
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@sentry/node": "^8.45.0",
    "@trigger.dev/sdk": "^3.3.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "pg": "^8.14.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "resend": "^4.3.0",
    "svix": "^1.45.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@trigger.dev/build": "^3.3.0",
    "@types/bun": "^1.1.14",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "testcontainers": "^10.16.0",
    "typescript": "^5.7.3"
  }
}
