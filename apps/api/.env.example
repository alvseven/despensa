# API
API_PORT=3333
NODE_ENV=development

# Comma-separated list of origins permitted by CORS.
# Production should pin to https://app.despensa.ai,https://despensa.ai (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging / observability
LOG_LEVEL=info
SENTRY_DSN=

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/despensa
DRIZZLE_KIT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/despensa

# Postgres (used by docker-compose only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=despensa

# Clerk — https://dashboard.clerk.com
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Resend (notification emails) — https://resend.com
RESEND_API_KEY=

# Trigger.dev (only needed locally if running `bun trigger:dev`/`trigger:deploy`)
# TRIGGER_PROJECT_REF=
# TRIGGER_ACCESS_TOKEN=
