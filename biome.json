{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "extends": ["@arthurfiorette/biomejs-config"],
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error"
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "files": {
    "ignore": [
      "apps/api/aws/lambdas/*",
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/.turbo/**"
    ]
  }
}
